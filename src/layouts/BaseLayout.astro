---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Harshal Hattyangdi | Full-Stack Software Engineer",
  description = "Portfolio for Harshal Hattyangdi, a full-stack software engineer specialising in React, TypeScript, frontend architecture, and platform modernisation.",
  structuredData
} = Astro.props;

const structuredDataMarkup = structuredData ? JSON.stringify(structuredData) : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="author" content="Harshal Hattyangdi" />
    <meta
      name="keywords"
      content="Harshal Hattyangdi, Full-Stack Software Engineer, React Developer, TypeScript Developer, Frontend Engineer, Platform Engineer, Design Systems, Next.js, Node.js"
    />
    <meta name="theme-color" content="#f6f2ea" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="me" href="https://www.linkedin.com/in/harshal-hattyangdi/" />
    <title>{title}</title>
    {structuredDataMarkup && (
      <script type="application/ld+json" set:html={structuredDataMarkup} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
